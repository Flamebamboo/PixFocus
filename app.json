{
  "expo": {
    "name": "PixFocus",
    "slug": "PixFocus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/NewIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "assets/images/SplashScreen.png",

      "resizeMode": "contain",
      "backgroundColor": "#9482da",
      "packagerOpts": {
        "config": "metro.config.js",
        "sourceExts": ["expo.ts", "expo.tsx", "expo.js", "expo.jsx", "ts", "tsx", "js", "jsx", "json", "wasm", "svg"]
      },
      "ios": {
        "supportsTablet": true,
        "bundleIdentifier": "com.flamebamboo.PixFocus"
      },
      "plugins": ["expo-router", "expo-font", "@notifee/react-native"],
      "experiments": {
        "typedRoutes": true
      }
    },
    "plugins": ["expo-router", "expo-font", "expo-localization", "expo-asset"],
    "android": {
      "package": "com.anonymous.StudyHub"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.StudyHub",
      "appleTeamId": "R6MWNA5V4W"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f6dce225-fb96-4df0-a336-bcf0e7de1aa7"
      }
    }
  }
}
