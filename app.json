{
  "expo": {
    "name": "PixFocus",
    "slug": "PixFocus",
    "version": "1.0.0",

    "orientation": "portrait",
    "icon": "assets/images/NewIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "assets/images/SplashScreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#9482da",
      "packagerOpts": {
        "config": "metro.config.js",
        "sourceExts": ["expo.ts", "expo.tsx", "expo.js", "expo.jsx", "ts", "tsx", "js", "jsx", "json", "wasm", "svg"]
      }
    },
    "plugins": ["expo-router", "expo-font", "expo-localization", "expo-asset", "expo-router", "expo-font"],
    "android": {
      "package": "com.anonymous.PixFocus",
      "adaptiveIcon": {
        "foregroundImage": "assets/images/NewIcon.png",
        "backgroundColor": "#9482da"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.StudyHub",
      "appleTeamId": "R6MWNA5V4W",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "19719b10-2979-4fbd-a46b-75d55134ad5c"
      }
    }
  }
}
